# ==============================================================================
# MY CHAPTERS BACKEND CONFIGURATION (.env.example)
# Copy this file to .env and supply actual development credentials.
# Never commit .env to version control.
# ==============================================================================

# Application environment (development | production | test)
NODE_ENV=development

# Server port
PORT=5000

# MongoDB Connection URI (Standalone or Replica Set / Atlas)
# Note: Multi-document transactions require a replica set (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/my_chapters?replicaSet=rs0

# Cryptographically strong secret for signing JWTs (Minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_at_least_32_characters_secret_key_123456

# JWT and Session expiration duration (e.g. 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# Private access code required for Admin signup (backend verified exclusively)
ACCESS_CODE=MY_CHAPTERS_EARLY_ACCESS_2026

# Allowed Frontend URL for CORS and origin verification
CLIENT_URL=http://localhost:5173

# Domain for HttpOnly cookies (leave empty for localhost development)
# For cross-subdomain in production, set to e.g. .example.com
COOKIE_DOMAIN=

# Bounded In-Memory Authentication Cache
AUTH_CACHE_TTL_SECONDS=45
AUTH_CACHE_MAX_ENTRIES=1000

# Database Query Profiling
SLOW_QUERY_THRESHOLD_MS=100
ENABLE_QUERY_PROFILING=true


