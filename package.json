{
  "name": "my-chapters",
  "version": "1.0.0",
  "description": "My Chapters - Personal Life Documentation Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm install && npm --prefix server install && npm --prefix client install && node scripts/build-production.js",
    "build:client": "node scripts/build-production.js",
    "server:start": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "server:test": "npm --prefix server test",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "start": "node server/src/server.js",
    "dev": "npm --prefix client run dev",
    "test": "npm --prefix server test"
  }
}
